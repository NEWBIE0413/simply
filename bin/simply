#!/bin/zsh
# simply [project-dir] — start the auditor (pi + simply extension) in the current tmux pane.
# Worker pane creation is handled by the auditor's spawn_worker tool, so run this inside a tmux session.
set -e
export SIMPLY_HOME="${SIMPLY_HOME:-$HOME/realmyworld/simply}"
PROJECT="${1:-$PWD}"
if [ -z "$TMUX" ]; then
  echo "simply: run inside a tmux session (required for worker pane creation)" >&2
  exit 1
fi
cd "$PROJECT"
exec pi -e "$SIMPLY_HOME/extension/simply.ts" "${@:2}"
